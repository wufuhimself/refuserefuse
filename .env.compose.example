# Copy to .env next to docker-compose.yml and customize.

# Browser frontend reads this at build/dev runtime in Vite.
# The default compose setup routes /api through nginx to backend.
VITE_API_BASE_URL=/api

# Optional social auth variables used by frontend + backend.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=

# Replace for anything beyond local development.
JWT_SECRET=dev-secret-change-me

# Optional analytics profile settings.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=analytics
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
