# JWT signing key for backend-issued access tokens
JWT_SECRET=change-me

# Comma-separated Google OAuth client IDs that are allowed to mint ID tokens
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# Comma-separated Apple audiences accepted by backend token verification
# Include Apple Service ID (web) and iOS bundle identifier
APPLE_AUDIENCES=com.refuserefuse.web,com.refuserefuse.mobile
